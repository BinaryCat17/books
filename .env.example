# Скопируй в tools/.env и заполни своими значениями.
#   umask 077 && cp .env.example tools/.env
# Файл не версионируется (см. .gitignore) и читается только скриптами.

MISTRAL_API_KEY=
GHCR_USER=
GHCR_TOKEN=
# Ключ vast.ai живёт отдельно, в ~/.config/vastai/vast_api_key:
#   vastai set api-key <КЛЮЧ>
