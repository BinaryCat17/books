# Скопируй в .env В КОРНЕ проекта и заполни своими значениями.
#   umask 077 && cp .env.example .env
# Файл не версионируется (см. .gitignore) и читается только скриптами.
#
# Путь именно такой: `config.ENV_FILE` — это `.env` рядом с pyproject.toml.
# Прежде здесь было написано `tools/.env`, и это работало лишь потому, что
# `config.py` держал запасной путь; сам каталог `tools/` содержит теперь
# только venv.

GHCR_USER=
GHCR_TOKEN=
# Ключ vast.ai живёт отдельно, в ~/.config/vastai/vast_api_key:
#   vastai set api-key <КЛЮЧ>
