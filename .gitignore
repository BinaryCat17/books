# Комментарий в .gitignore живёт ТОЛЬКО на своей строке: `#` в хвосте образца
# git считает частью образца, а не пояснением. Проверено здесь же: строка
# `raw/  # 9.7 ГБ` перестаёт прятать raw/ целиком и молча.

# секреты — раньше всего остального
.env
*.env
!.env.example

# окружения
venv/
tools/venv/
.venv/
__pycache__/
*.py[cod]
.uv/

# pytest в .venv нет, бегун свой (tests/run.py), но проверки написаны так,
# чтобы pytest подобрал их без правок, — поставят его, появится и кеш.
.pytest_cache/

# Оригиналы: 9.7 ГБ сканов, из них 9.4 — набор AnnoPage с Zenodo
# (DOI 10.5281/zenodo.12788419, CC BY 4.0), качается заново по DOI.
raw/

# 427 МБ, шесть книг прежнего разбора; чем они полезны — в CLAUDE.md.
processed/

# Журнал аренды: 111 записей на $4.98, в них instance_id и machine_id живых
# машин vast.ai. Наружу им не надо, а восстанавливаться им неоткуда — держи
# копию вне репозитория.
runs/

# рабочее
*.log
out.tgz
.DS_Store
*.egg-info/
build/
dist/

# ─── стенды ───────────────────────────────────────────────────────────────
# Правило одно: в git едет то, чего не пересобрать бесплатно, — истина, слепок
# входа и вывод, за который заплачено на арендованной карте. Всё, что местный
# процессор отдаёт по одной команде, не едет.

# Сами книги стендов: 472 МБ annopage, 168 annopage-lite, 100 hard, 23 hard36.
# Собираются из raw/ командами `books annopage` и `books subset`, sha256 pdf
# записан в manifest.json рядом.
bench/*/*.pdf

# Кроме трёх настоящих сканов (9.4 МБ): исходников у них нет ниоткуда, они
# сами и есть источник.
!bench/real/*.pdf

# Листы с рамками для глаз: 2.8 ГБ у annopage, 162 МБ у hard36. Рисуются
# `books overlay` за минуты и смотрятся один раз.
bench/*/check/

# Вывод детектора: 25 МБ на annopage. `books detect` считает его на процессоре
# бесплатно. Слепок входа лежит отдельным файлом detect/run.json (16 КБ) и
# ОСТАЁТСЯ в git: без него неизвестно, при каких ручках получены числа в docs/.
bench/*/detect/pages/

# Продукт первого уровня, 12 МБ на книгу: `books html` из detect/.
bench/*/html/

# То, что уехало бы в VLM: `books feed` кладёт по картинке на текстовый блок.
# 12 МБ на 13 страницах slovar — это 1.4 ГБ на 600 страницах annopage. У шести
# синтетических книг каталог уже закрыт правилом выше, у annopage, annopage-lite,
# hard и hard36 не был закрыт ничем (`git check-ignore` возвращал 1).
bench/*/detect/feed/
bench/*/feed/

# Последняя страница прогона картинкой, 1.7 МБ, — отладочный след, не данные.
bench/*/dots/_page.png

# Исключение из `*.log` выше: 72 КБ на два файла — единственный след прогона,
# за который заплачено ($0.89 за 600 страниц на RTX 4090). Последние строки
# держат величины, на которые ссылается docs/: 8925 рамок, 23 неразобранных,
# 14.22 с/страница. Заново эти числа стоят денег.
!bench/*/dots/job.log

# Шесть синтетических книг: от 34 (slovar) до 158 МБ (spravochnik). Собираются
# побайтово теми же — зерно, профиль старения и sha256 генератора записаны в
# manifest.json. Каталог гасится содержимым (`/*`, а не `/`): каталог, закрытый
# целиком, не отпирается изнутри никаким `!`.
bench/spravochnik/*
bench/slovar/*
bench/matematika/*
bench/atlas/*
bench/katalog/*
bench/zhurnal/*

# Манифест — единственное, что от синтетической книги остаётся: по нему видно,
# что пересборка после правки synth.py дала уже ДРУГУЮ книгу.
!bench/*/manifest.json
