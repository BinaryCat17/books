bench/matematika/
bench/slovar/
bench/spravochnik/
bench/zhurnal/
bench/hard/
bench/*/read/
bench/*/truth.new/
bench/*/truth.previous/
processed/
raw/
users/
*.sqlite*
images/ui/dist/
