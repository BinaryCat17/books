        {
            "block_label": "table",
            "block_content": "<table><tr><td>Tool Rcom</td><td>12&quot; to 18&quot; inc.</td><td>20&quot; to 36&quot; inc.</td></tr><tr><td>Lathes</td><td>Engine Laihes</td><td>Engine Laihes</td></tr><tr><td>0&quot; to .0008&quot;</td><td>0 to .001&quot;</td><td>0 to .0015&quot;</td></tr><tr><td colspan=\"3\">(High at tailstock end)</td></tr></table>",
