                [
                    89.0,
                    797.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "No mention has been made of minor components, such as taper attachments, special fixtures etc. But it is felt that if scraping or alignment is needed on these members, there is sufficient information available in these pages to assist the scraping operator when treating them.",
