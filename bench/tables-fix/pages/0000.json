        {
            "block_label": "text",
            "block_content": "It makes no difference where the tail-stock is placed on the ways for these operations, since the bed should now be in perfect condition. Ordinarily, one part of the bed ways is used as the position from which to conduct the alignment tests. Another portion is coated with compound and utilized as a spotting template. This practice increases speed because much clean up time is eliminated.",
            "block_bbox": [
                92,
                502,
                492,
                728
            ],
            "block_id": 4,
            "block_order": 2,
            "group_id": 4,
            "block_polygon_points": [
