        {
            "block_label": "table",
            "block_content": "<table><tr><td>Tool Room</td><td>12&quot; to 18&quot; inc.</td><td>20&quot; to 36&quot; inc.</td></tr><tr><td>Lathes</td><td>Engine Lathes</td><td>Engine Lathe</td></tr><tr><td>0 to .0005&quot;</td><td>0 to .001&quot;</td><td>0 to .0015&quot;</td></tr><tr><td colspan=\"3\">(on diameter)</td></tr><tr><td>0 to .001&quot;</td><td>0 to .0015&quot;</td><td>0 to .002&quot;</td></tr><tr><td colspan=\"3\">(on face at nominal diameter)</td></tr></table>",
            "block_bbox": [
