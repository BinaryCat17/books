        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\begin{array}{cccc}Teoi Room&12^{\\circ}to 18^{\\circ}me.&20^{\\circ}to 34^{\\circ}to\\\\Laths&Eng\\\\to,0005^{\\circ}&0to,0005^{\\circ}&0^{\\circ}to,0010^{\\circ}\\\\\\end{array} $$ ",
