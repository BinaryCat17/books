        {
            "block_label": "text",
            "block_content": "Tool Room 12\" to 18\" inc. 20\" to 36\" inc.\nLathes Engine Lathes Engine Lathes\n0 to .004\" 0 to .004\" 0 to .005\"",
            "block_bbox": [
