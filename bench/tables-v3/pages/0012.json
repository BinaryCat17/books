        {
            "block_label": "text",
            "block_content": "This procedure involves taking the measurements over a distance of 12\". Starting at any distance from the headstock, the half nut is closed on the lead screw. Then the carriage is moved along the bed by turning the lathe spindle by hand. A count is made of the total number of revolutions which theoretically should advance the carriage the standard 12\".\nTwo measurements are executed. The first, is made in conjunction with a fixed type end gage, as shown in Fig. 26.70a. This determines the starting position.",
            "block_bbox": [
                104,
                1132,
                508,
                1335
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    104.0,
                    1132.0
                ],
                [
                    508.0,
                    1132.0
                ],
                [
                    508.0,
                    1335.0
                ],
                [
                    104.0,
                    1335.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "",
            "block_bbox": [
                520,
                62,
                917,
                153
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
                [
                    520.0,
                    62.0
                ],
                [
                    917.0,
                    62.0
                ],
                [
                    917.0,
