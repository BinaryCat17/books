        {
            "block_label": "text",
            "block_content": "There are several possible causes if a taper is in evidence, namely:",
            "block_bbox": [
                87,
                75,
                467,
                120
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
