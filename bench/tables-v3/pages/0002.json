        {
            "block_label": "paragraph_title",
            "block_content": "Sec. 26.58\nAccuracy Tests on the Headstock Spindle",
            "block_bbox": [
                526,
                699,
                919,
                747
            ],
            "block_id": 13,
            "block_order": 9,
            "group_id": 13,
            "block_polygon_points": [
                [
