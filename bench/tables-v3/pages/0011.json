        {
            "block_label": "text",
            "block_content": "Due to the removal of metal from various bearing surfaces, the lead screw will be misaligned if replaced without adjustment of its bearings. For proper adjustment the lead screw must be lowered to obtain a correct alignment with the half nuts. In addition, the lead screw must be aligned to the bed ways.",
            "block_bbox": [
                96,
                513,
                495,
                694
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
