        {
            "block_label": "table",
            "block_content": "<table><tr><td>Sec. 26.59</td></tr><tr><td>Spindle Center Runout (1st test)</td></tr></table>",
            "block_bbox": [
                176,
                175,
                782,
                266
            ],
            "block_id": 1,
            "block_order": null,
