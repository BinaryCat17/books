            "group_id": 15
        },
        {
            "block_label": "figure_title",
            "block_content": "PLATE 33. Close-up showing application of DIAL INDICATOR for testing alignment of headstock spindle in vertical plane. (Courtesy - South Bend Lathe Works.)",
            "block_bbox": [
                1053,
                917,
                1837,
                1060
            ],
            "block_id": 16,
            "block_order": null,
            "group_id": 16
        },
        {
            "block_label": "paragraph_title",
            "block_content": "PROCEDURE:",
            "block_bbox": [
                1055,
                1150,
                1331,
                1194
            ],
            "block_id": 17,
            "block_order": 6,
            "group_id": 17
        },
        {
            "block_label": "text",
            "block_content": "We will now by a series of tests determine approximately the degree of misalignment between the axis of headstock spindle and 1) DATUM PLANE and 2) axis of tailstock spindle. Apropos to this the headstock can, in the early stages of testing, be set on the bed without clamping. The final tests, though, should be conducted with it bolted solidly in position to obtain maximum precision.",
            "block_bbox": [
                1052,
                1239,
                1849,
                1685
            ],
            "block_id": 18,
            "block_order": 7,
            "group_id": 18
