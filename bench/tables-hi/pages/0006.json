        {
            "block_label": "table",
            "block_content": "<table><tr><td colspan=\"3\">RECOMMENDED STANDARDS</td></tr><tr><td>Tool Room</td><td>12&quot; to 18&quot; inc.</td><td>20&quot; to 36&quot; inc.</td></tr><tr><td>Lathe</td><td>Engine Lathe</td><td>Engine Lathe</td></tr><tr><td>0 to .0005&quot;</td><td>0 to .001&quot;</td><td>0 to .001&quot;</td></tr><tr><td colspan=\"3\">(high at end of 12&quot; test bar)</td></tr></table>",
            "block_bbox": [
