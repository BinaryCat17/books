            ],
            "block_id": 3,
            "block_order": null,
            "group_id": 3
        },
        {
            "block_label": "figure_title",
            "block_content": "Fig. 26.59 Alignment of head stock spindle in vertical plane.",
            "block_bbox": [
                214,
