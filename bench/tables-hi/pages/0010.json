            ],
            "block_id": 16,
            "block_order": 10,
            "group_id": 16
        },
        {
            "block_label": "text",
            "block_content": "The accompanying chart Fig. 26.66, discloses the recommended standards for the back lash on the cross feed screw and on the compound rest feed screw.",
            "block_bbox": [
                1021,
                849,
                1817,
                1029
            ],
            "block_id": 17,
            "block_order": 11,
            "group_id": 17
        },
        {
            "block_label": "table",
            "block_content": "The feed screws are tested for back lash, while threaded into their respective nuts.",
            "block_bbox": [
                1024,
                1029,
                1811,
                1165
            ],
            "block_id": 18,
            "block_order": null,
            "group_id": 18
        },
        {
