        },
        {
            "block_label": "figure_title",
            "block_content": "Fig. 26.65 Final alignment of compound rest top. Movement of slide parallel with work spindle in vertical plane. Tol. max. .0035\" per foot.",
            "block_bbox": [
                1035,
                1543,
                1805,
                1656
