        {
            "block_label": "text",
            "block_content": "The vertical milling machine falls into two principal classifications, viz:",
            "block_bbox": [
                94,
                300,
                491,
                347
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2
        },
        {
            "block_label": "table",
            "block_content": "1. The Sliding Head Vertical Miller, wherein the head is adjustable in a vertical direction while the axis of the spindle remains in a vertical plane.",
            "block_bbox": [
                95,
                366,
                487,
                455
            ],
            "block_id": 3,
            "block_order": null,
            "group_id": 3
        },
        {
            "block_label": "table",
            "block_content": "2. The Swivel Head Vertical Miller, wherein the head is held at a fixed height but is free to swivel, thereby allowing the axis of the spindle to be in any plane between vertical and horizontal.",
            "block_bbox": [
                95,
                455,
                474,
                590
            ],
            "block_id": 4,
            "block_order": null,
            "group_id": 4
        },
