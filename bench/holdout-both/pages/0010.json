        },
        {
            "block_label": "text",
            "block_content": "In the following pages a vertical milling machine utilizing the Sliding Head will be discussed. Fig. 28.1 shows such a machine completely assembled. This familiar machine tool has many points of similarity to a horizontal miller but it also has other distinctive features which are peculiar to it alone, and therefore of special interest to the scraping operator. For this reason, a detailed description of the problem and the procedure involved in reconditioning the Vertical Miller is justified.",
            "block_bbox": [
                95,
                1118,
                487,
                1364
            ],
            "block_id": 7,
            "block_order": 2,
            "group_id": 7
        },
