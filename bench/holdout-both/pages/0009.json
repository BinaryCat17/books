        {
            "block_label": "text",
            "block_content": "Axis of Pivot Offset with respect to Axis of Spindle.",
            "block_bbox": [
                94,
                181,
                479,
                226
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2
        },
        {
            "block_label": "paragraph_title",
            "block_content": "PROCEDURE:",
            "block_bbox": [
                95,
                247,
                233,
                267
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3
        },
        {
            "block_label": "text",
            "block_content": "A test bar is inserted in the spindle, given a run out test and turned to place the mean position of eccentricity error in the horizontal plane. The table is moved longitudinally until one end is flushed with the end of the saddle. The universal saddle-table assembly is now adjusted transversely on the knee to locate the axis of the pivot approximately under the free end of the test bar. A DIAL INDICATOR is rigidly positioned on the table top with the plunger adjusted to touch the free end of the test bar at the horizontal diameter.",
            "block_bbox": [
                93,
                269,
                489,
                555
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4
        },
        {
            "block_label": "text",
            "block_content": "The table is swiveled  $ 18^{\\circ} $ thus placing the plunger of the instrument against the test bar on the opposite side. The difference between the two readings indicates the amount of offset of the axis of the pivot with the axis of the spindle. The tolerance allowed is shown in Fig. 27.98. If the tolerance is exceeded, the reason may be found outlined in Sec. 27.8C.",
            "block_bbox": [
                93,
                556,
                488,
                758
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5
        },
        {
            "block_label": "image",
            "block_content": "",
            "block_bbox": [
                205,
                824,
                377,
                1013
            ],
            "block_id": 6,
            "block_order": null,
            "group_id": 6
        },
        {
            "block_label": "figure_title",
            "block_content": "Fig. 27.98 Axis of pivot offset with respect to axis of spindle. Tolerance max. .002\".",
            "block_bbox": [
                111,
                1066,
                460,
                1104
            ],
            "block_id": 7,
            "block_order": null,
            "group_id": 7
        },
        {
            "block_label": "text",
            "block_content": "Sec. 27.111\nSTATIC ALIGNMENT TEST NO. 17",
            "block_bbox": [
                516,
