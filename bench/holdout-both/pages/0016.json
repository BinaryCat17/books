        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td>Fig. 29.61(a)</td><td>Back Lash in Lead Screws. Read on Dials.</td><td>max. tolerance</td></tr><tr><td>Table screw</td><td>.005&quot;</td><td></td></tr><tr><td>Cross Feed screw</td><td>.005&quot;</td><td></td></tr><tr><td>Vertical Feed screw</td><td>.008&quot;</td><td></td></tr><tr><td>Sliding Head screw</td><td>.005&quot;</td><td></td></tr></table>",
