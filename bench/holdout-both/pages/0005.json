        {
            "block_label": "table",
            "block_content": "<table><tr><td>Sec. 27.101</td></tr><tr><td>STATIC ALIGNMENT TEST NO. 8(part1)</td></tr></table>",
            "block_bbox": [
                520,
                579,
                922,
                624
            ],
            "block_id": 0,
            "block_order": null,
