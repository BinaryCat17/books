            "block_label": "vision_footnote",
            "block_content": "PLATE 29. Close-up of hand scraping the ways on a lathe bed. (Courtesy - South Bend Lathe Works.)",
            "block_bbox": [
                101,
                488,
                503,
                526
            ],
