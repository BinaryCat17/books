        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td>Tool Room</td><td>12&quot; to 18&quot; inc.</td><td>20&quot; to 36&quot; inc.</td></tr><tr><td>lathes</td><td>Engine lathes</td><td>Engine lathes</td></tr><tr><td>.0005&quot; in 48&quot;</td><td>.00075&quot; in 48&quot;</td><td>.001&quot; in 48&quot;</td></tr><tr><td colspan=\"3\">(Maximum reading along length of bed)</td></tr></table>",
            "block_bbox": [
