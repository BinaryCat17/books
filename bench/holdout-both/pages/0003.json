            "group_id": 9
        },
        {
            "block_label": "text",
            "block_content": "Additionally, the PRECISION LEVEL is set crosswise from time to time, on the bed flat way. It is desirable to keep this surface horizontal so that when the machine is placed in operation, wear will be uniform on both ways.",
            "block_bbox": [
                527,
                751,
                924,
                884
            ],
            "block_id": 10,
            "block_order": 6,
            "group_id": 10
        },
        {
            "block_label": "text",
            "block_content": "Scraping is continued until all OBJECTIVES are satisfied.",
