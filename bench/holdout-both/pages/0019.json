        {
            "block_label": "table",
            "block_content": "<table><tr><td>a) The Table (2) is a long, relatively thin, rectangular casting ribbed for strength. It has two groups of bearing surfaces. Underneath are the slides which bear on the bed ways, permitting longitudinal movement. The top surface of the table supports the swivel plate.</td></tr></table>",
            "block_bbox": [
                129,
                1006,
                504,
