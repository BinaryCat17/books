        {
            "block_label": "text",
            "block_content": "Center the table. Then press two ground PARALLELS into the center T-slot at points equi-distant from the midpoint of the table. After inserting the arbor into the spindle hole, a DIAL INDICATOR with attached arm is fastened to it. The swing round method is utilized to obtain a DIAL reading against each ground PARALLEL in turn.",
            "block_bbox": [
                92,
                490,
                480,
                689
            ],
            "block_id": 9,
            "block_order": 6,
            "group_id": 9
        },
        {
