            "block_content": "<table><tr><td colspan=\"3\">RECOMMENDED STANDARDS</td></tr><tr><td>Tool Room</td><td>12&quot; to 18&quot; inc.</td><td>20&quot; to 36&quot; inc.</td></tr><tr><td>Lathes</td><td>Engine Lathes</td><td>Engine Lathes</td></tr><tr><td colspan=\"3\">(Total indicator reading)</td></tr><tr><td>0 to .0004&quot;</td><td>0 to .0005&quot;</td><td>0 to .00075&quot;</td></tr><tr><td colspan=\"3\">Sec. 26.61</td></tr><tr><td colspan=\"3\">Cam Action of Spindle (3rd test)</td></tr></table>",
