        {
            "block_label": "vision_footnote",
            "block_content": "(1) ground stud (2) sleeve (3) parallel bar (4) DIAL INDICATOR (5) DIAL INDICATOR (6) parallel bar (7) end gage (8) precision V-block.",
            "block_bbox": [
