        {
            "block_label": "table",
            "block_content": "<table><tr><td>Tool Room</td><td>12&quot; to 18&quot; inc.</td><td>20&quot; to 36&quot; inc.</td></tr><tr><td>Lathes</td><td>Engine Lathes</td><td>Engine Lathes</td></tr><tr><td>0 to .0005&quot;</td><td>0 to .0008&quot;</td><td>0 to .0015&quot;</td></tr><tr><td colspan=\"3\">(High at end of spindle when fully extended)</td></tr></table>",
            "block_bbox": [
                518,
