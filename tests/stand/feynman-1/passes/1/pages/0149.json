                199
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2
        },
        {
            "block_label": "figure_title",
            "block_content": "Таблица 8.4 ☐ СКОРОСТЬ ПАДАЮЩЕГО ШАРА",
            "block_bbox": [
                100,
