        {
            "block_label": "text",
            "block_content": "Использование высокожженого шамота, многоша-\nмотных масс, совместного помола глины и шамота и\nприменение высоких давлений при прессовании умень-\nшают усадку при обжиге.",
            "block_bbox": [
                130,
                437,
                703,
                524
            ],
