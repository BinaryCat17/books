            "group_id": 3
        },
        {
            "block_label": "text",
            "block_content": "Ниже приведена пористость шамотных изделий, %, при полусухом прессовании (1) и пластичном формова-нии (II):",
            "block_bbox": [
                1,
                225,
                567,
                298
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4
        },
        {
            "block_label": "text",
            "block_content": "Размер канальных пор 5—25 мкм. Распределение пор по размерам:",
            "block_bbox": [
                5,
                403,
                569,
                456
            ],
            "block_id": 5,
