            "group_id": 5
        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td>4,</td><td>MKM</td><td>(объем), %</td><td>&lt;5</td><td>1—5</td><td>0,1—1</td><td>&lt;0,1</td></tr><tr><td>Количество (объем), %</td><td>35—64</td><td>0,5—45</td><td>2—50</td><td>0—8</td><td></td><td></td></tr></table>",
            "block_bbox": [
                5,
                456,
                560,
